{
  "expo": {
    "name": "Smile",
    "slug": "smile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/smile_icon.png",
    "scheme": "smile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.smile.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/smile_icon.png",
        "backgroundImage": "./assets/images/smile_icon.png",
        "monochromeImage": "./assets/images/smile_icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.smile.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyD6divF7TxsR32_IOY4ZG1t8_kqN9m6WMU"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43b40003-a2c6-4461-b21e-635b0f5a1d5d"
      }
    },
    "owner": "arome.dev2"
  }
}
